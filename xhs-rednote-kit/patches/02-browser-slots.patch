+// limitedBrowser holds its slot until Chromium has been closed, including QR login.
+type limitedBrowser struct {
+	*headless_browser.Browser
+	release func()
+	once    sync.Once
+}
+
+func (b *limitedBrowser) Close() {
+	b.once.Do(func() {
+		defer b.release()
+		b.Browser.Close()
+	})
+}
+
+func newBrowser(ctx context.Context) (*limitedBrowser, error) {
+	release, err := acquireBrowserSlot(ctx)
+	if err != nil {
+		return nil, err
+	}
+	// Browser startup can panic; never leak a permit on that path.
+	created := false
+	defer func() {
+		if !created {
+			release()
+		}
+	}()
+	b := browser.NewBrowser(configs.IsHeadless(),
 		browser.WithFingerprintSeed(configs.FingerprintSeed()),
 		browser.WithProxy(configs.Proxy()),
 	)
+	created = true
+	return &limitedBrowser{Browser: b, release: release}, nil
 }
 
