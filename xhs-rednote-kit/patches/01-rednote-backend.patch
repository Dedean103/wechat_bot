+package configs
+
+import (
+	"os"
+	"strings"
+
+	"github.com/sirupsen/logrus"
+)
+
+const (
+	BackendXiaohongshu = "xiaohongshu"
+	BackendRednote     = "rednote"
+)
+
+// BackendFromEnv selects which web product the browser automation uses.
+// RedNote accounts have cookies scoped to .rednote.com and must not be
+// validated against xiaohongshu.com.
+func BackendFromEnv() string {
+	backend := strings.ToLower(strings.TrimSpace(os.Getenv("XHS_BACKEND")))
+	switch backend {
+	case "", BackendXiaohongshu:
+		return BackendXiaohongshu
+	case BackendRednote:
+		return BackendRednote
+	default:
+		logrus.Warnf("invalid XHS_BACKEND=%q, using %s", backend, BackendXiaohongshu)
+		return BackendXiaohongshu
+	}
+}
+
+func WebBaseURL() string {
+	if BackendFromEnv() == BackendRednote {
+		return "https://www.rednote.com"
+	}
+	return "https://www.xiaohongshu.com"
+}
+
+func CreatorBaseURL() string {
+	if BackendFromEnv() == BackendRednote {
+		return "https://creator.rednote.com"
+	}
+	return "https://creator.xiaohongshu.com"
+}
diff --git a/configs/backend_test.go b/configs/backend_test.go
new file mode 100644
index 0000000..2c398d6
--- /dev/null
+++ b/configs/backend_test.go
@@ -0,0 +1,33 @@
+package configs
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestBackendURLs(t *testing.T) {
+	t.Run("default uses Xiaohongshu", func(t *testing.T) {
+		t.Setenv("XHS_BACKEND", "")
+		assert.Equal(t, BackendXiaohongshu, BackendFromEnv())
+		assert.Equal(t, "https://www.xiaohongshu.com", WebBaseURL())
+		assert.Equal(t, "https://creator.xiaohongshu.com", CreatorBaseURL())
+	})
+
+	t.Run("rednote uses RedNote domains", func(t *testing.T) {
+		t.Setenv("XHS_BACKEND", "rednote")
+		assert.Equal(t, BackendRednote, BackendFromEnv())
+		assert.Equal(t, "https://www.rednote.com", WebBaseURL())
+		assert.Equal(t, "https://creator.rednote.com", CreatorBaseURL())
+	})
+
+	t.Run("backend is case insensitive", func(t *testing.T) {
+		t.Setenv("XHS_BACKEND", " REDNOTE ")
+		assert.Equal(t, BackendRednote, BackendFromEnv())
+	})
+
+	t.Run("invalid backend falls back safely", func(t *testing.T) {
+		t.Setenv("XHS_BACKEND", "unknown")
+		assert.Equal(t, BackendXiaohongshu, BackendFromEnv())
+	})
+}
